# Set this in Vercel → Project Settings → Environment Variables
# Use the Supabase Session/Transaction pooler URL for serverless deploys.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Admin → Call API. The URL base and API key are read on the server and never shown to the browser.
LESSON_API_BASE_URL=http://localhost:5000
LESSON_API_KEY=your-api-key
